# Copy to .env.local and fill in. .env.local is never committed.

# --- Stripe (server only) ---
# Test secret key: Stripe dashboard → Developers → API keys (Test mode). Must start with sk_test_.
STRIPE_SECRET_KEY=sk_test_...
# Optional locally: signing secret for /api/stripe-webhook (from `stripe listen` or the dashboard webhook).
# STRIPE_WEBHOOK_SECRET=whsec_...

# --- Supabase ---
# Browser-safe values: Supabase → Project Settings → API Keys.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only — never prefix with VITE_. Lets the server save orders and check who is signed in.
SUPABASE_SECRET_KEY=sb_secret_...

# Optional: the public URL of the site, used for Stripe's return links (set this on Vercel).
# SITE_URL=https://your-site.vercel.app
