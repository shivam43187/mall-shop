# Copy to .env.local and fill in. .env.local is never committed.
# Stripe test secret key: Stripe dashboard → Developers → API keys (Test mode). Must start with sk_test_.
STRIPE_SECRET_KEY=sk_test_...
# Optional: the public URL of the site, used for Stripe's return links (set this on Vercel).
# SITE_URL=https://your-site.vercel.app
